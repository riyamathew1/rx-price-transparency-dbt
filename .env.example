# Copy to .env (git-ignored) and fill in. Never commit .env or paste these in chat.
# Load with:  set -a; source .env; set +a
DBT_TARGET=duckdb
DUCKDB_PATH=rx.duckdb

# Snowflake trial account identifier, e.g. orgname-accountname or the locator form
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=RX_TRANSFORMER
SNOWFLAKE_WAREHOUSE=RX_WH
SNOWFLAKE_DATABASE=RX_PRICES
SNOWFLAKE_SCHEMA=DEV
# Key-pair auth (target: snowflake). Keep the key OUTSIDE the repo, e.g. ~/.snowflake/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Password auth (target: snowflake_password)
SNOWFLAKE_PASSWORD=
SNOWFLAKE_AUTHENTICATOR=snowflake
